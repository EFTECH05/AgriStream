
@model Agristream.Models.Farm

@{
    ViewData["Title"] = "Delete Farm";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <span class="text-danger fw-semibold small text-uppercase">
            AgriStream Administration
        </span>
        <h2 class="fw-bold mb-1">Delete Farm</h2>
        <p class="text-muted mb-0">
            Review the farm information before confirming deletion.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                        Confirm Farm Deletion
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning">
                        <strong>Warning:</strong>
                        Are you sure you want to delete this farm?
                        This action may not be reversible.
                    </div>

                    <dl class="row mb-4">

                        <dt class="col-sm-4">Farm ID</dt>
                        <dd class="col-sm-8">@Model.FarmId</dd>

                        <dt class="col-sm-4">Farm Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.FarmName</dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@Model.Location</dd>

                        <dt class="col-sm-4">Farm Size</dt>
                        <dd class="col-sm-8">@Model.SizeInHectares hectares</dd>

                        <dt class="col-sm-4">Registered</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMMM yyyy")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description provided."
                                : Model.Description)
                        </dd>

                    </dl>

                    <form asp-action="Delete"
                          asp-controller="Farm"
                          method="post">

                        <input type="hidden" asp-for="FarmId" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Farm"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>
                                Confirm Delete
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
