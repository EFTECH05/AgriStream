
@model Agristream.Models.Farm

@{
    ViewData["Title"] = "Farm Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">
                AgriStream Administration
            </span>
            <h2 class="fw-bold mb-1">Farm Details</h2>
            <p class="text-muted mb-0">
                View information about this registered farm.
            </p>
        </div>

        <a asp-controller="Farm"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Farms
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-house-door-fill text-primary me-2"></i>
                        @Model.FarmName
                    </h5>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">Farm ID</small>
                            <strong>@Model.FarmId</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">Farm Name</small>
                            <strong>@Model.FarmName</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">Location</small>
                            <strong>@Model.Location</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">Farm Size</small>
                            <strong>@Model.SizeInHectares hectares</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">Date Registered</small>
                            <strong>@Model.CreatedAt.ToString("dd MMMM yyyy")</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block mb-1">Farm Status</small>
                            <strong>@(Model.IsActive ? "Active" : "Inactive")</strong>
                        </div>

                        <div class="col-12">
                            <hr />
                            <small class="text-muted d-block mb-2">Description</small>

                            <p class="mb-0">
                                @(string.IsNullOrWhiteSpace(Model.Description)
                                    ? "No description provided."
                                    : Model.Description)
                            </p>
                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white p-3">
                    <a asp-controller="Farm"
                       asp-action="Index"
                       class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Return to Farm Management
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>
