
@model Agristream.Models.Farm

@{
    ViewData["Title"] = "Register New Farm";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">
                AgriStream Administration
            </span>
            <h2 class="fw-bold mb-1">Register New Farm</h2>
            <p class="text-muted mb-0">
                Add a farm to the AgriStream farm network.
            </p>
        </div>

        <a asp-controller="Farm"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Farms
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-house-add text-success me-2"></i>
                        Farm Information
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Create"
                          asp-controller="Farm"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FarmName"
                                   class="form-label fw-semibold">
                                Farm Name
                            </label>

                            <input asp-for="FarmName"
                                   class="form-control"
                                   placeholder="Enter farm name" />

                            <span asp-validation-for="FarmName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location"
                                   class="form-label fw-semibold">
                                Farm Location
                            </label>

                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="Enter farm location" />

                            <span asp-validation-for="Location"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SizeInHectares"
                                   class="form-label fw-semibold">
                                Farm Size (Hectares)
                            </label>

                            <input asp-for="SizeInHectares"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control"
                                   placeholder="e.g. 25.50" />

                            <span asp-validation-for="SizeInHectares"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Farm Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe the farm, its activities and crops..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-semibold">
                                Active Farm
                            </label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Farm"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                <i class="bi bi-check-circle me-1"></i>
                                Register Farm
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
