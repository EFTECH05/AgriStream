
@{
    ViewData["Title"] = "AgriStream | Smart Farming";
}

<div class="agri-home">

    <!-- Hero -->
    <section class="agri-hero">
        <div class="hero-overlay"></div>

        <!-- AgriStream Logo -->
        <div class="hero-images">
            <img src="~/images/lo1.png"
                 alt="AgriStream Logo"
                 class="agri-logo-image" />
        </div>

        <div class="hero-content">
            <div class="hero-label">
                <span class="status-dot"></span>
                SMART AGRICULTURE TECHNOLOGY
            </div>

            <h1>
                Grow Smarter.<br />
                <span>Farm Better.</span>
            </h1>

            <p>
                Bringing agriculture and technology together.
                Monitor farm conditions, process real-time sensor
                data and manage your agricultural operations
                with AgriStream IoT.
            </p>

            <div class="hero-buttons">
                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn-primary-custom">
                    Get Started <span>→</span>
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn-secondary-custom">
                    Sign In
                </a>
            </div>

            <div class="hero-note">
                <span>✓ Smart monitoring</span>
                <span>✓ Cloud-powered</span>
                <span>✓ Real-time processing</span>
            </div>
        </div>

        <div class="hero-dashboard">
            <div class="dashboard-heading">
                <div>
                    <small>AGRISTREAM PLATFORM</small>
                    <h3>Farm Intelligence</h3>
                </div>
                <span class="dashboard-leaf">🌱</span>
            </div>

            <div class="dashboard-stats">
                <div class="stat">
                    <span>🌡️</span>
                    <small>Temperature</small>
                    <strong>24°C</strong>
                </div>

                <div class="stat">
                    <span>💧</span>
                    <small>Humidity</small>
                    <strong>68%</strong>
                </div>

                <div class="stat">
                    <span>🌿</span>
                    <small>Crop status</small>
                    <strong>Healthy</strong>
                </div>
            </div>

            <div class="dashboard-chart">
                <div class="chart-heading">
                    <span>Sensor activity</span>
                    <span class="live-label">● LIVE</span>
                </div>

                <div class="chart-bars">
                    <span style="height:35%"></span>
                    <span style="height:55%"></span>
                    <span style="height:43%"></span>
                    <span style="height:75%"></span>
                    <span style="height:58%"></span>
                    <span style="height:90%"></span>
                    <span style="height:72%"></span>
                    <span style="height:100%"></span>
                </div>

                <div class="chart-footer">
                    <span>Real-time data</span>
                    <span>IoT monitoring</span>
                </div>
            </div>

            <div class="dashboard-footer">
                <span><i></i> Connected agriculture</span>
                <strong>IoT + Cloud</strong>
            </div>
        </div>

        <div class="floating-info floating-one">
            <span>📡</span>
            <div>
                <strong>IoT Sensors</strong>
                <small>Connected monitoring</small>
            </div>
        </div>

        <div class="floating-info floating-two">
            <span>☁️</span>
            <div>
                <strong>Cloud Technology</strong>
                <small>Secure data management</small>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="intro-section" id="features">

        <div class="section-heading">
            <span class="section-label">THE AGRISTREAM ADVANTAGE</span>

            <h2>
                Technology for a <span>smarter harvest.</span>
            </h2>

            <p>
                An intelligent platform designed to connect farm
                monitoring, data processing and cloud technology.
            </p>
        </div>

        <!-- Agriculture Banner Image -->
        <div class="agri-banner">
            <img src="~/images/we.png"
                 alt="AgriStream Smart Agriculture"
                 class="agri-banner-image" />
        </div>

        <div class="feature-grid">

            <div class="feature-card">
                <div class="feature-top">
                    <div class="feature-icon green-icon">📡</div>
                    <span class="feature-number">01</span>
                </div>

                <h3>Smart Farm Monitoring</h3>

                <p>
                    Collect agricultural information using IoT
                    sensors to monitor farm environmental conditions.
                </p>

                <div class="feature-link">
                    Connected monitoring <span>→</span>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-top">
                    <div class="feature-icon blue-icon">⚡</div>
                    <span class="feature-number">02</span>
                </div>

                <h3>Real-Time Processing</h3>

                <p>
                    Process incoming sensor readings and telemetry
                    to support informed agricultural decisions.
                </p>

                <div class="feature-link">
                    Intelligent processing <span>→</span>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-top">
                    <div class="feature-icon orange-icon">☁️</div>
                    <span class="feature-number">03</span>
                </div>

                <h3>Cloud Integration</h3>

                <p>
                    Leverage cloud services to host applications
                    and manage farm images and agricultural data.
                </p>

                <div class="feature-link">
                    Cloud-powered platform <span>→</span>
                </div>
            </div>

        </div>
    </section>

    <!-- Call to Action -->
    <section class="agri-cta">
        <div>
            <span class="cta-label">START YOUR JOURNEY</span>

            <h2>Let's build a smarter future for farming.</h2>

            <p>
                Get started with AgriStream and explore the future
                of connected agriculture.
            </p>
        </div>

        <a asp-controller="Account"
           asp-action="Register"
           class="cta-button">
            Create Your Account →
        </a>
    </section>

</div>
