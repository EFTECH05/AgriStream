

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Welcome Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-success mb-1">
                <i class="bi bi-speedometer2"></i> Admin Dashboard
            </h2>
            <p class="text-muted mb-0">
                Welcome to AgriStream IoT Management System.
                Manage your farms, users and monitoring services.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <span class="badge bg-success-subtle text-success px-3 py-2">
                <i class="bi bi-shield-check"></i> Administrator
            </span>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">Total Users</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <div class="bg-success-subtle text-success rounded-3 p-3">
                            <i class="bi bi-people fs-3"></i>
                        </div>
                    </div>
                    <small class="text-muted">Registered system users</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">Total Farms</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <div class="bg-primary-subtle text-primary rounded-3 p-3">
                            <i class="bi bi-house-door fs-3"></i>
                        </div>
                    </div>
                    <small class="text-muted">Registered farms</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">Sensor Readings</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <div class="bg-warning-subtle text-warning rounded-3 p-3">
                            <i class="bi bi-activity fs-3"></i>
                        </div>
                    </div>
                    <small class="text-muted">Collected IoT readings</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-2">Drone Images</p>
                            <h3 class="fw-bold mb-0">--</h3>
                        </div>
                        <div class="bg-info-subtle text-info rounded-3 p-3">
                            <i class="bi bi-images fs-3"></i>
                        </div>
                    </div>
                    <small class="text-muted">Stored farm images</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Management Section -->
    <div class="row g-4 mb-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-1">System Management</h5>
                    <p class="text-muted small">
                        Manage the main components of AgriStream.
                    </p>
                </div>

                <div class="card-body px-4 pb-4">
                    <div class="row g-3">

                        <!-- User Management -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <div class="text-success mb-3">
                                    <i class="bi bi-people fs-2"></i>
                                </div>

                                <h6 class="fw-bold">User Management</h6>

                                <p class="text-muted small">
                                    View and manage registered users.
                                </p>

                                <span class="badge bg-secondary">
                                    Coming soon
                                </span>
                            </div>
                        </div>

                        <!-- Farm Management -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <div class="text-primary mb-3">
                                    <i class="bi bi-house-door fs-2"></i>
                                </div>

                                <h6 class="fw-bold">Farm Management</h6>

                                <p class="text-muted small">
                                    Manage farm information and registrations.
                                </p>

                                <a asp-controller="Farm"
                                   asp-action="Index"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-arrow-right-circle"></i>
                                    Manage Farms
                                </a>
                            </div>
                        </div>

                        <!-- Sensor Monitoring -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <div class="text-warning mb-3">
                                    <i class="bi bi-activity fs-2"></i>
                                </div>

                                <h6 class="fw-bold">Sensor Monitoring</h6>

                                <p class="text-muted small">
                                    Monitor incoming IoT sensor readings.
                                </p>

                                <span class="badge bg-secondary">
                                    Coming soon
                                </span>
                            </div>
                        </div>

                        <!-- Drone Images -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <div class="text-info mb-3">
                                    <i class="bi bi-camera fs-2"></i>
                                </div>

                                <h6 class="fw-bold">Drone Images</h6>

                                <p class="text-muted small">
                                    Manage uploaded agricultural images.
                                </p>

                                <span class="badge bg-secondary">
                                    Coming soon
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Administrator Information -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center"
                             style="width:80px;height:80px;">
                            <i class="bi bi-person-gear fs-1"></i>
                        </div>

                        <h5 class="fw-bold mt-3 mb-1">
                            System Administrator
                        </h5>

                        <p class="text-muted small mb-0">
                            AgriStream Management
                        </p>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <small class="text-muted">Administrator Email</small>
                        <p class="fw-semibold mb-0">
                            @User.Identity?.Name
                        </p>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Account Role</small>
                        <p class="fw-semibold text-success mb-0">
                            Administrator
                        </p>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">Account Status</small>
                        <p class="fw-semibold mb-0">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Active
                        </p>
                    </div>

                    <hr />

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger w-100">
                            <i class="bi bi-box-arrow-right"></i>
                            Logout
                        </button>

                    </form>

                </div>
            </div>
        </div>

    </div>

    <!-- System Information -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-3">
                <div class="bg-success-subtle text-success rounded-3 p-3">
                    <i class="bi bi-cloud-check fs-3"></i>
                </div>

                <div>
                    <h6 class="fw-bold mb-1">
                        AgriStream IoT Platform
                    </h6>

                    <p class="text-muted small mb-0">
                        Centralised agricultural monitoring and
                        management platform.
                    </p>
                </div>
            </div>

        </div>
    </div>

</div>

