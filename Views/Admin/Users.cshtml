
@model IEnumerable<Agristream.Controllers.AdminUserViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">
                AgriStream Administration
            </span>
            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-muted mb-0">
                View registered AgriStream platform accounts.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Registered Users
            </h5>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <span class="text-muted">Total registered accounts:</span>
                <strong class="ms-2">@Model.Count()</strong>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x text-muted"
                       style="font-size: 3rem;"></i>

                    <h5 class="mt-3">No Users Found</h5>
                    <p class="text-muted">
                        There are currently no registered accounts.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Email Address</th>
                                <th>Username</th>
                                <th>Account ID</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @user.FullName
                                    </td>

                                    <td>@user.Email</td>

                                    <td>@user.UserName</td>

                                    <td>
                                        <small class="text-muted">
                                            @user.Id
                                        </small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
