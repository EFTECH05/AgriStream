@{
    ViewData["Title"] = "Farmer Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="farmer-dashboard">

    <!-- Welcome Banner -->
    <section class="farmer-hero mb-4">
        <div class="farmer-hero-content">
            <span class="farmer-eyebrow">
                <i class="bi bi-flower1"></i> AGRISTREAM FARM MONITORING
            </span>

            <h1>Welcome to Your Farm Dashboard</h1>

            <p>
                Monitor environmental conditions, keep track of your sensors
                and manage your agricultural activities in one place.
            </p>

            <div class="farmer-hero-user">
                <span class="farmer-avatar">
                    <i class="bi bi-person-fill"></i>
                </span>

                <span>
                    <small>Signed in as</small>
                    <strong>@User.Identity?.Name</strong>
                </span>
            </div>
        </div>

        <div class="farmer-hero-art">
            <i class="bi bi-tree-fill"></i>
            <i class="bi bi-cloud-sun-fill"></i>
        </div>
    </section>

    <!-- Overview Heading -->
    <div class="farmer-section-heading">
        <div>
            <h4>Farm Overview</h4>
            <p>A quick look at your farm monitoring information.</p>
        </div>

        <span class="farmer-demo-label">
            <i class="bi bi-info-circle"></i> Demonstration data
        </span>
    </div>

    <!-- Overview Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="farmer-stat-card">
                <div class="farmer-stat-top">
                    <div class="farmer-stat-icon farms">
                        <i class="bi bi-houses-fill"></i>
                    </div>
                    <span class="farmer-stat-caption">FARM NETWORK</span>
                </div>

                <h2>03</h2>
                <p>Registered Farms</p>

                <div class="farmer-stat-bottom">
                    <i class="bi bi-check-circle-fill"></i>
                    Sample farm count
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="farmer-stat-card">
                <div class="farmer-stat-top">
                    <div class="farmer-stat-icon temperature">
                        <i class="bi bi-thermometer-half"></i>
                    </div>
                    <span class="farmer-stat-caption">TEMPERATURE</span>
                </div>

                <h2>26<small>°C</small></h2>
                <p>Environmental Temperature</p>

                <div class="farmer-stat-bottom">
                    <i class="bi bi-check-circle-fill"></i>
                    Sample reading
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="farmer-stat-card">
                <div class="farmer-stat-top">
                    <div class="farmer-stat-icon moisture">
                        <i class="bi bi-droplet-half"></i>
                    </div>
                    <span class="farmer-stat-caption">SOIL CONDITION</span>
                </div>

                <h2>68<small>%</small></h2>
                <p>Soil Moisture</p>

                <div class="farmer-stat-bottom">
                    <i class="bi bi-check-circle-fill"></i>
                    Sample reading
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="farmer-stat-card">
                <div class="farmer-stat-top">
                    <div class="farmer-stat-icon sensors">
                        <i class="bi bi-broadcast"></i>
                    </div>
                    <span class="farmer-stat-caption">IOT NETWORK</span>
                </div>

                <h2>08</h2>
                <p>Connected Sensors</p>

                <div class="farmer-stat-bottom">
                    <i class="bi bi-info-circle-fill"></i>
                    Sample sensor count
                </div>
            </div>
        </div>

    </div>

    <!-- Environmental Monitoring -->
    <div class="farmer-panel mb-4">

        <div class="farmer-panel-header">
            <div>
                <h4>
                    <i class="bi bi-cloud-sun"></i>
                    Environmental Monitoring
                </h4>
                <p>Sample environmental conditions for your farm.</p>
            </div>

            <span class="farmer-panel-tag">
                <i class="bi bi-activity"></i> Sample readings
            </span>
        </div>

        <div class="row g-4">

            <!-- Temperature -->
            <div class="col-md-4">
                <div class="farmer-environment-card">
                    <div class="farmer-environment-top">
                        <span>Temperature</span>
                        <i class="bi bi-thermometer-half"></i>
                    </div>

                    <div class="farmer-environment-value">
                        26<small>°C</small>
                    </div>

                    <div class="farmer-progress">
                        <div class="farmer-progress-fill temperature-fill"
                             style="width:52%"></div>
                    </div>

                    <span class="farmer-reading-status">
                        <i class="bi bi-check-circle-fill"></i>
                        Sample value
                    </span>
                </div>
            </div>

            <!-- Humidity -->
            <div class="col-md-4">
                <div class="farmer-environment-card">
                    <div class="farmer-environment-top">
                        <span>Humidity</span>
                        <i class="bi bi-moisture"></i>
                    </div>

                    <div class="farmer-environment-value">
                        55<small>%</small>
                    </div>

                    <div class="farmer-progress">
                        <div class="farmer-progress-fill humidity-fill"
                             style="width:55%"></div>
                    </div>

                    <span class="farmer-reading-status">
                        <i class="bi bi-check-circle-fill"></i>
                        Sample value
                    </span>
                </div>
            </div>

            <!-- Soil Moisture -->
            <div class="col-md-4">
                <div class="farmer-environment-card">
                    <div class="farmer-environment-top">
                        <span>Soil Moisture</span>
                        <i class="bi bi-droplet-half"></i>
                    </div>

                    <div class="farmer-environment-value">
                        68<small>%</small>
                    </div>

                    <div class="farmer-progress">
                        <div class="farmer-progress-fill moisture-fill"
                             style="width:68%"></div>
                    </div>

                    <span class="farmer-reading-status">
                        <i class="bi bi-check-circle-fill"></i>
                        Sample value
                    </span>
                </div>
            </div>

        </div>
    </div>

    <!-- Drone Image Upload -->
    <section class="farmer-drone-banner mb-4">

        <div class="farmer-drone-icon">
            <i class="bi bi-camera-fill"></i>
        </div>

        <div class="farmer-drone-content">
            <h4>Drone Image Management</h4>
            <p>
                Upload aerial photographs of your agricultural land
                and store your farm imagery in Azure Blob Storage.
            </p>
        </div>

        <a asp-controller="DroneImages"
           asp-action="Upload"
           class="farmer-primary-btn">
            <i class="bi bi-cloud-arrow-up"></i>
            Upload Drone Image
        </a>

    </section>

    <!-- Sensor Status and Recent Readings -->
    <div class="row g-4 mb-4">

        <!-- Sensor Status -->
        <div class="col-xl-5">
            <div class="farmer-panel h-100">

                <div class="farmer-panel-header">
                    <div>
                        <h4>
                            <i class="bi bi-cpu"></i>
                            Sensor Health
                        </h4>
                        <p>Sample sensor connection information.</p>
                    </div>
                </div>

                <div class="farmer-sensor-list">

                    <div class="farmer-sensor-item">
                        <div class="farmer-sensor-icon">
                            <i class="bi bi-thermometer-half"></i>
                        </div>

                        <div class="farmer-sensor-info">
                            <strong>Temperature Sensor</strong>
                            <small>Temperature monitoring</small>
                        </div>

                        <span class="farmer-sensor-badge online">
                            Online
                        </span>
                    </div>

                    <div class="farmer-sensor-item">
                        <div class="farmer-sensor-icon">
                            <i class="bi bi-moisture"></i>
                        </div>

                        <div class="farmer-sensor-info">
                            <strong>Humidity Sensor</strong>
                            <small>Humidity monitoring</small>
                        </div>

                        <span class="farmer-sensor-badge online">
                            Online
                        </span>
                    </div>

                    <div class="farmer-sensor-item">
                        <div class="farmer-sensor-icon">
                            <i class="bi bi-droplet-half"></i>
                        </div>

                        <div class="farmer-sensor-info">
                            <strong>Soil Sensor</strong>
                            <small>Soil moisture monitoring</small>
                        </div>

                        <span class="farmer-sensor-badge online">
                            Online
                        </span>
                    </div>

                    <div class="farmer-sensor-item">
                        <div class="farmer-sensor-icon">
                            <i class="bi bi-water"></i>
                        </div>

                        <div class="farmer-sensor-info">
                            <strong>Water Sensor</strong>
                            <small>Water level monitoring</small>
                        </div>

                        <span class="farmer-sensor-badge offline">
                            Offline
                        </span>
                    </div>

                </div>

                <div class="farmer-information-note">
                    <i class="bi bi-info-circle"></i>
                    Sensor statuses shown are demonstration values.
                </div>

            </div>
        </div>

        <!-- Recent Readings -->
        <div class="col-xl-7">
            <div class="farmer-panel h-100">

                <div class="farmer-panel-header">
                    <div>
                        <h4>
                            <i class="bi bi-clipboard-data"></i>
                            Recent Sensor Readings
                        </h4>
                        <p>Example readings from farm monitoring sensors.</p>
                    </div>
                </div>

                <div class="table-responsive farmer-table-wrapper">
                    <table class="table farmer-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Sensor</th>
                                <th>Reading</th>
                                <th>Recorded</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>
                                    <strong>Temperature</strong>
                                    <small>Environmental</small>
                                </td>
                                <td>26°C</td>
                                <td>Sample</td>
                                <td>
                                    <span class="farmer-table-status normal">
                                        Normal
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Humidity</strong>
                                    <small>Environmental</small>
                                </td>
                                <td>55%</td>
                                <td>Sample</td>
                                <td>
                                    <span class="farmer-table-status normal">
                                        Normal
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Soil Moisture</strong>
                                    <small>Soil monitoring</small>
                                </td>
                                <td>68%</td>
                                <td>Sample</td>
                                <td>
                                    <span class="farmer-table-status normal">
                                        Normal
                                    </span>
                                </td>
                            </tr>
                        </tbody>

                    </table>
                </div>

                <div class="farmer-information-note">
                    <i class="bi bi-info-circle"></i>
                    Live telemetry is not connected to this table yet.
                </div>

            </div>
        </div>

    </div>

    <!-- Recent Activities -->
    <div class="farmer-panel mb-4">

        <div class="farmer-panel-header">
            <div>
                <h4>
                    <i class="bi bi-clock-history"></i>
                    Recent Activities
                </h4>
                <p>Available dashboard features and activities.</p>
            </div>
        </div>

        <div class="farmer-activity-list">

            <div class="farmer-activity-item">
                <div class="farmer-activity-icon green">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div>
                    <strong>Farm monitoring dashboard accessed</strong>
                    <small>Dashboard access information</small>
                </div>
            </div>

            <div class="farmer-activity-item">
                <div class="farmer-activity-icon blue">
                    <i class="bi bi-activity"></i>
                </div>

                <div>
                    <strong>Sensor monitoring information displayed</strong>
                    <small>Demonstration monitoring information</small>
                </div>
            </div>

            <div class="farmer-activity-item">
                <div class="farmer-activity-icon orange">
                    <i class="bi bi-camera-fill"></i>
                </div>

                <div>
                    <strong>Drone image upload feature available</strong>
                    <small>Upload agricultural images through the platform</small>
                </div>
            </div>

        </div>

    </div>

    <!-- Footer -->
    <footer class="farmer-footer">
        <span>AgriStream IoT Farm Monitoring System</span>
        <span>Farmer Portal</span>
    </footer>

</div>
